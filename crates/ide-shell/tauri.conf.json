{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "h1code",
  "version": "0.1.0",
  "identifier": "com.h1code.shell",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": {
      "cwd": "../../ui",
      "script": "npm run dev"
    },
    "beforeBuildCommand": {
      "cwd": "../../ui",
      "script": "npm run build"
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "<h1code>",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "maximized": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
